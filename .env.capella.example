# ─── Full project config: CAPELLA backend ──────────────────────────────
# Covers every notebook/app (01-09) plus the Agent Memory *server* (docker --env-file).
# To activate: cp .env.capella.example .env.capella, fill it in, then
#   cp .env.capella .env       # notebooks/apps only read `.env`
# See .env.server.example for the local-Couchbase variant.

# ─── Couchbase cluster ────────────────────────────────────────────────
CB_CONN_STRING=couchbases://cb.xxxx.cloud.couchbase.com
CB_USERNAME=your_username
CB_PASSWORD=your_password
CB_BUCKET=ai
# Root cert for couchbases:// TLS, if your client needs it explicitly:
# CB_CERTIFICATE=/path/to/cluster/root/certificate

# OPENAI_API_KEY is needed regardless of which block (A/B) you pick below for your
# notebooks/apps' own LLM calls — the Agent Memory *server* (Chapter 9 §9.7,
# apps/support-agent) always uses OpenAI models internally for its own fact
# extraction/embedding (AGENTMEMORY_EMBEDDING_MODEL / AGENTMEMORY_LLM_MODEL further
# down), independent of whether your client code talks to OpenAI or Capella Model
# Service. Without it, the Agent Memory server container crash-loops on startup.
OPENAI_API_KEY=sk-...

# ─── Models: pick ONE of the two blocks ───────────────────────────────
# A) OpenAI (default in all notebooks/apps)
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# B) Capella Model Service (Chapter 8) — the code (notebooks 02-06, 08, 10,
# apps/rag-api) reads exactly these four vars. Endpoint must end with /v1. CAPELLA_AI_TOKEN is the
# Capella AI API key/token issued with the deployment; if your tenant instead
# authenticates via database credentials, leave it unset — the code falls back to
# base64(CB_USERNAME:CB_PASSWORD) automatically.
# CAPELLA_AI_ENDPOINT=https://ai....cloud.couchbase.com/v1
# CAPELLA_AI_TOKEN=cbsk-v1-...
# CAPELLA_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# CAPELLA_EMBEDDING_MODEL=intfloat/e5-mistral-7b-instruct
# CAPELLA_EMBEDDING_DIM=4096          # must match your vector index `dims`

# ─── Capella AI Functions (Chapter 7 / notebook 04) ───────────────────
# AI_FUNCTIONS_ENABLED=true      # only on a Capella cluster with AI Functions configured

# ─── Vector index DDL (Chapter 14 / notebook 11) ──────────────────────
# CB_SUPPORTS_VECTOR_DDL=true    # only on Couchbase Server/Capella 8.0+ (Hyperscale/Composite indexes)

# ─── Eventing service (notebook 13) ────────────────────────────────────
# CB_SUPPORTS_EVENTING=true      # add Eventing to a service group on this Capella cluster first

# ─── Analytics service (notebook 14) ───────────────────────────────────
# CB_SUPPORTS_ANALYTICS=true     # add Analytics to a service group on this Capella cluster first

# ─── Managed Agent Memory (Chapter 9 / notebook 09 / support-agent app) ─
# Client side: the couchbase-agent-memory SDK talks to the server over HTTP.
# Port 8080 here — the local variant (.env.server.example) uses 8081, so both
# server instances can run at the same time without a port clash.
AGENTMEMORY_BASE_URL=http://localhost:8080
# AGENTMEMORY_TOKEN=             # JWT — only when OIDC_AUTH_ENABLED=true

# Server side: this file doubles as the server's --env-file.
# REQUIRED: download the cluster's root CA certificate from the Capella UI first —
#   your cluster → "Connect" tab → "Security Certificates" (or "Certificate") →
#   Download Certificate — save it as ./ca.pem next to this file. couchbases:// (TLS)
#   connections fail without it; the -v mount below is what makes it visible to the
#   container at the path AGENTMEMORY_CONN_ROOT_CERTIFICATE points to.
#   docker run -d --name agentmemory-server-capella \
#     --env-file .env.capella \
#     -p 8080:8080 -p 9090:9090 \
#     -v agentmemory-capella-logs:/app/logs \
#     -v $(pwd)/ca.pem:/app/certs/ca.pem:ro \
#     --restart unless-stopped \
#     agentmemory-server:arm64   # :amd64 + --platform linux/amd64 on Intel
AGENTMEMORY_CONN_STRING=couchbases://cb.xxxx.cloud.couchbase.com
AGENTMEMORY_USERNAME=your_username
AGENTMEMORY_PASSWORD=your_password
# No separate bucket needed — reuse the same "ai" bucket as everything else in this
# repo (notebook 01 provisions it). The server creates its own scopes/collections
# inside whatever bucket you point it at; a dedicated bucket is only worth it if you
# want separate quota/backup/eviction policy from the rest of the data.
AGENTMEMORY_BUCKET=ai
AGENTMEMORY_EMBEDDING_MODEL=text-embedding-3-small
AGENTMEMORY_LLM_MODEL=gpt-4o-mini
AGENTMEMORY_SERVER_HOST=0.0.0.0
AGENTMEMORY_SERVER_PORT=8080
OIDC_AUTH_ENABLED=false
LOG_LEVEL=INFO
# Path INSIDE the container (matches the -v mount above) — not a path on your host.
# Downloaded from the Capella UI (see the REQUIRED note above), not created by you.
AGENTMEMORY_CONN_ROOT_CERTIFICATE=/app/certs/ca.pem

# ─── Agent Catalog (Chapters 10-11 / notebook 07 / support-agent app) ─
# This repo-root file is for notebook 07's scratch `agentc_demo` catalog. If you're
# running apps/support-agent, use its OWN .env.capella (apps/support-agent/.env.capella)
# with a DIFFERENT AGENT_CATALOG_BUCKET instead of copying this one as-is — agentc
# resolves "latest catalog snapshot" bucket-wide across every published project, with
# no per-project scoping, so two projects sharing one bucket will silently clobber
# each other's "latest" as you `agentc publish` each. See
# apps/support-agent/README.md's "Why a separate file" note for the full mechanism.
AGENT_CATALOG_CONN_STRING=couchbases://cb.xxxx.cloud.couchbase.com
AGENT_CATALOG_USERNAME=your_username
AGENT_CATALOG_PASSWORD=your_password
AGENT_CATALOG_BUCKET=ai
AGENT_CATALOG_CONN_ROOT_CERTIFICATE=/path/to/cluster/root/certificate

TOKENIZERS_PARALLELISM=false

# ─── Couchbase MCP server (Chapter 12) — dedicated least-privilege user ─
# MCP_CB_USERNAME=mcp_readonly
# MCP_CB_PASSWORD=...
