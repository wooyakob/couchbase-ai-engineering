# ─── Full project config: SERVER (local Couchbase) backend ─────────────────────
# Covers every notebook/app (01-09) plus the Agent Memory *server* (docker --env-file).
# To activate: cp .env.server.example .env.server, fill it in, then
#   cp .env.server .env         # notebooks/apps only read `.env`
# See .env.capella.example for the Capella-backed variant.

# ─── Couchbase cluster ────────────────────────────────────────────────
CB_CONN_STRING=couchbase://localhost
CB_USERNAME=Administrator
CB_PASSWORD=password
CB_BUCKET=ai

# ─── Models: pick ONE of the two blocks ───────────────────────────────
# A) OpenAI (default in all notebooks/apps)
OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# B) Capella Model Service (Chapter 8) — endpoint must end with /v1.
# CAPELLA_AI_ENDPOINT=https://ai....cloud.couchbase.com/v1
# CAPELLA_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# CAPELLA_EMBEDDING_MODEL=intfloat/e5-mistral-7b-instruct

# ─── Capella AI Functions (Chapter 7 / notebook 04) ───────────────────
# AI_FUNCTIONS_ENABLED=true      # only on a Capella cluster with AI Functions configured

# ─── Vector index DDL (Chapter 14 / notebook 11) ──────────────────────
# CB_SUPPORTS_VECTOR_DDL=true    # only on Couchbase Server/Capella 8.0+ (Hyperscale/Composite indexes)

# ─── Managed Agent Memory (Chapter 9 / notebook 09 / support-agent app) ─
# Client side: the couchbase-agent-memory SDK talks to the server over HTTP.
# Use port 8081 here (not 8080) so a local server instance can run alongside
# a Capella-pointed one (see .env.capella.example) without a port clash.
AGENTMEMORY_BASE_URL=http://localhost:8081
# AGENTMEMORY_TOKEN=             # JWT — only when OIDC_AUTH_ENABLED=true

# Server side: this file doubles as the server's --env-file. It connects to
# your host machine's Couchbase, so it must use host.docker.internal, NOT
# localhost — inside the container, "localhost" means the container itself.
#   docker run -d --name agentmemory-server-local \
#     --env-file .env.server \
#     -p 8081:8080 -p 9091:9090 \
#     -v agentmemory-local-logs:/app/logs \
#     --restart unless-stopped \
#     agentmemory-server:arm64   # :amd64 + --platform linux/amd64 on Intel
AGENTMEMORY_CONN_STRING=couchbase://host.docker.internal
AGENTMEMORY_USERNAME=Administrator
AGENTMEMORY_PASSWORD=password
AGENTMEMORY_BUCKET=ai
AGENTMEMORY_EMBEDDING_MODEL=text-embedding-3-small
AGENTMEMORY_LLM_MODEL=gpt-4o-mini
AGENTMEMORY_SERVER_HOST=0.0.0.0
AGENTMEMORY_SERVER_PORT=8080
OIDC_AUTH_ENABLED=false
LOG_LEVEL=INFO

# ─── Agent Catalog (Chapters 10-11 / notebook 07 / support-agent app) ─
# This repo-root file is for notebook 07's scratch `agentc_demo` catalog. If you're
# running apps/support-agent, use its OWN .env.server (apps/support-agent/.env.server)
# with a DIFFERENT AGENT_CATALOG_BUCKET instead of copying this one as-is — agentc
# resolves "latest catalog snapshot" bucket-wide across every published project, with
# no per-project scoping, so two projects sharing one bucket will silently clobber
# each other's "latest" as you `agentc publish` each. See
# apps/support-agent/README.md's "Why a separate file" note for the full mechanism.
AGENT_CATALOG_CONN_STRING=couchbase://localhost
AGENT_CATALOG_USERNAME=Administrator
AGENT_CATALOG_PASSWORD=password
AGENT_CATALOG_BUCKET=ai

# Secrets referenced by cataloged tools (separate namespace from AGENT_CATALOG_*)
CB_CERTIFICATE=
TOKENIZERS_PARALLELISM=false

# ─── Couchbase MCP server (Chapter 12) — dedicated least-privilege user ─
# MCP_CB_USERNAME=mcp_readonly
# MCP_CB_PASSWORD=...
